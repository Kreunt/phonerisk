          }
        }
      }
    },
    "/api/v1/numverify/validate": {
      "get": {
        "summary": "Validate a number in Numverify's response format",
        "description": "Validate a number and answer in Numverify's response format.\n\nAs with Numverify, `number` is in international format (the \"+\" is\noptional) unless `country_code` says which country a national number\nbelongs to.",
        "operationId": "numverifyValidate",
        "parameters": [
          {
            "$ref": "#/components/parameters/RapidAPIHost"
          },
          {
            "name": "number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Number"
            }
          },
          {
            "name": "country_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Country Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NumverifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },

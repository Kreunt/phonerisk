    "/api/v1/examples/{country}": {
      "get": {
        "summary": "Example numbers of a country",
        "description": "Example numbers of every line type a country has, for test suites and input placeholders.",
        "operationId": "examples",
        "parameters": [
          {
            "$ref": "#/components/parameters/RapidAPIHost"
          },
          {
            "name": "country",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "title": "Country"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExamplesResponse"
                }
              }

    "/api/v1/short-number": {
      "get": {
        "summary": "Describe an emergency number or short code",
        "description": "Describe an emergency number or short code (112, 911, 5-digit SMS codes) as dialled inside a country.",
        "operationId": "shortNumber",
        "parameters": [
          {
            "$ref": "#/components/parameters/RapidAPIHost"
          },
          {
            "name": "number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",

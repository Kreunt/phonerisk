            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchLookupResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/extract": {
      "post": {
        "summary": "Find and look up every phone number in a text",
        "description": "Find every valid phone number in a block of text and look each one up.",
        "operationId": "extract",
        "parameters": [
          {
            "$ref": "#/components/parameters/RapidAPIHost"
          },
          {
            "name": "nocache",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Nocache"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {

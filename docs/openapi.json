          },
          "rfc3966": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rfc3966"
          },
          "dial_from_format": {
            "anyOf": [
              {
                "type": "string"
              },
              {

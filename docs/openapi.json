{
  "openapi": "3.1.0",
  "info": {
    "title": "PhoneRisk API",
    "version": "0.2.0",
    "description": "Validates a phone number and says how risky it looks: validity, line type, carrier, country, local time, disposable-number detection and a 0-100 risk score with the reason behind every point. Answers come from numbering-plan data and public lists of disposable numbers; no request is made to the phone network, so the API cannot tell whether a number is in service."
  },
  "paths": {
    "/api/v1/lookup": {
      "post": {
        "summary": "Look up one phone number",
        "operationId": "lookup",
        "parameters": [
          {
            "$ref": "#/components/parameters/RapidAPIHost"
          },
          {
            "name": "nocache",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Nocache"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LookupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "The input could not be read as a phone number"
          }
        }
      },
      "get": {
        "summary": "Look up one phone number, with query parameters",
        "description": "Same lookup with the number in the URL, handy for trying the API out.",
        "operationId": "lookupByQuery",
        "parameters": [
          {
            "$ref": "#/components/parameters/RapidAPIHost"
          },
          {
            "name": "default_region",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Default Region"
            }
          },
          {
            "name": "dial_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Dial From"
            }
          },
          {
            "name": "at",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "At"
            }
          },
          {
            "name": "number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Number"
            }
          },
          {
            "name": "nocache",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Nocache"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "The input could not be read as a phone number"
          }
        }
      }
    },
    "/api/v1/lookup/batch": {
      "post": {
        "summary": "Look up several phone numbers",
        "description": "Look up many numbers at once. Entries that are not phone numbers get a result instead of failing the batch.",
        "operationId": "lookupBatch",
        "parameters": [
          {
            "$ref": "#/components/parameters/RapidAPIHost"
          },
          {
            "name": "nocache",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Nocache"
            }

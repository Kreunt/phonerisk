                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "The input could not be read as a phone number"
          }
        }
      }
    },
    "/api/v1/vanity": {
      "get": {
        "summary": "Turn the letters of a vanity number into digits",
        "description": "Turn the letters of a vanity number (1-800-FLOWERS) into the digits to dial.",
        "operationId": "vanity",
        "parameters": [
          {
            "$ref": "#/components/parameters/RapidAPIHost"
          },
          {
            "name": "number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "title": "Number"
            }
          },
          {
            "name": "default_region",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Default Region"
            }
